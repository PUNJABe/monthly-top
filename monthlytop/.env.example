# Copy to .env and fill in. Everything is optional for a local demo.

PORT=3000
# Public URL of your site (used for Stripe redirects and DataFast). No trailing slash.
BASE_URL=http://localhost:3000
SITE_NAME=Monthly Top

# ---- Money (Indian rupees) ----
# Currency for all boosts. Must be enabled on your Stripe account.
CURRENCY=inr
# Limits per boost in PAISE (100 paise = Rs 1). Boosts are always whole rupees.
# Defaults: minimum Rs 10, maximum Rs 9,99,999.
MIN_BOOST_CENTS=1000
MAX_BOOST_CENTS=99999900
# "This month" and "today" follow this time zone, so the chart resets at midnight India time.
SITE_TIMEZONE=Asia/Kolkata

# ---- Creator (shown on the About page and footer; leave empty until ready) ----
CREATOR_NAME=
CREATOR_HANDLE=
CREATOR_URL=
CREATOR_BIO=

# ---- Visitor numbers (DataFast) ----
# 1. In DataFast, add your site and copy its Website ID (looks like dfid_xxxxx).
# 2. Website settings -> API -> create a website API key (starts with df_). Keep it secret.
# 3. Optional: your public share link, used by the "stats" link in the header.
# With no API key the site uses its own simple cookieless counter instead.
DATAFAST_WEBSITE_ID=
DATAFAST_API_KEY=
DATAFAST_DOMAIN=
DATAFAST_SHARE_URL=

# ---- Stripe ----
# Optional. Locally defaults to demo if no Stripe key is set; on Vercel defaults to unconfigured (no fake payments).
# Set to "stripe" or "youpi" only after configuring durable Postgres and the provider credentials.
PAYMENT_PROVIDER=
# https://dashboard.stripe.com/apikeys. Leave empty to stay in DEMO mode (fake checkout).
STRIPE_SECRET_KEY=
# Developers -> Webhooks -> add endpoint BASE_URL/api/webhook, event checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# ---- YOUPI PG (optional hosted UPI gateway) ----
# Run YOUPI PG separately on a persistent Node host; point this at its HTTPS base URL.
YOUPI_API_URL=
YOUPI_MERCHANT_ID=
# Keep this secret. Configure the YOUPI merchant webhook URL as BASE_URL/api/youpi/webhook.
YOUPI_WEBHOOK_SECRET=

# ---- Admin ----
# Admin panel at /admin (username can be anything). Leave empty to disable.
ADMIN_PASSWORD=

# Optional pooled managed PostgreSQL connection string. When set, it is used instead of SQLite.
DATABASE_URL=
# SQLite fallback path (local/demo only on serverless hosts; /tmp is not durable across instances).
DATA_DIR=./data
